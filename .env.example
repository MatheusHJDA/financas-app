DATABASE_URL=postgresql+psycopg://financas:financas@db:5432/financas
POSTGRES_USER=financas
POSTGRES_PASSWORD=financas
POSTGRES_DB=financas
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=60
UPLOAD_DIR=/data/uploads
BACKUP_DIR=/data/backups
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
INITIAL_PIN_MATHEUS=
INITIAL_PIN_RUTH=
TZ=America/Sao_Paulo
SESSION_DAYS=30
# Swagger/OpenAPI em /api/docs e /api/openapi.json. Desligado por padrao; ligue (true) so para depurar.
ENABLE_DOCS=false
# Hosts aceitos no cabecalho Host, separados por virgula ("*.ts.net" cobre o endereco do Tailscale).
# Outro host (dominio proprio, VPS) recebe 400 "Invalid host header" ate ser listado aqui.
ALLOWED_HOSTS=localhost,127.0.0.1,*.ts.net
# Login em duas etapas (PIN + chave de acesso). Ligue so na VPS; RP_ID = DOMAIN; ORIGIN = https://DOMAIN.
REQUIRE_PASSKEY=false
PASSKEY_RP_ID=
PASSKEY_ORIGIN=
