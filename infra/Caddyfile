{$DOMAIN} {
	encode zstd gzip

	# Upload máximo do app é 10 MB (multipart com folga); recusa antes de chegar à API.
	request_body {
		max_size 11MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Content-Security-Policy "frame-ancestors 'none'"
	}

	# IP real de quem conecta (os limites de login são por origem): fixado aqui em vez de depender
	# do padrão do Caddy. Substitui qualquer X-Forwarded-For que o visitante tenha mandado.
	reverse_proxy api:8000 {
		header_up X-Forwarded-For {remote_host}
	}
}
